# --- Required ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Your Telegram user ID (get it from @userinfobot). Only this user can talk to the bot.
ALLOWED_USER_IDS=[123456789]

# Deepgram API key for voice-to-text. Sign up at https://deepgram.com.
# Leave empty if you don't need voice messages.
DEEPGRAM_API_KEY=

# --- Optional ---

# UI language: "en" (default) or "ru"
BOT_LANG=en

# Project root (used to resolve relative paths). Default: current dir.
PROJECT_ROOT=.

# Advanced split layout: leave empty to use PROJECT_ROOT for both.
# APP_ROOT contains installed code, the virtualenv, and optional base MCP profiles.
APP_ROOT=
# AGENT_WORKSPACE_ROOT contains editable projects and generated runtime state.
AGENT_WORKSPACE_ROOT=

# Default working directory for new topics. Keep "." for the public bot.
# On Windows, set an absolute project path to see its Codex Desktop sessions in /resume.
DEFAULT_CWD=.

# Where the bot saves downloaded media (photos, documents) for CC to read.
FILE_CACHE_DIR=./data

# Path to topic config (mode + cwd + system prompt per Telegram topic).
TOPIC_CONFIG_PATH=./topic_config.json

# Persistent terminal session state (tmux on Linux, ConPTY on Windows).
TMUX_SESSIONS_DIR=./tmux_sessions

# Agent defaults
# Models are configured per topic with "models" (preferred) or legacy "model".
CC_MAX_TURNS=100
CC_INACTIVITY_KILL_SEC=1800

# Optional absolute CLI paths for service environments where auto-discovery fails.
# TELEGRAM_CLAUDE_BIN=/absolute/path/to/claude
# TELEGRAM_CODEX_BIN=/absolute/path/to/codex

# Codex update command behavior
CODEX_AUTO_UPDATE_ENABLED=true
CODEX_UPDATE_TIMEOUT_SEC=180
CODEX_UPDATE_COOLDOWN_SEC=86400

# Optional: chat ID where notifications go. Defaults to first allowed_user_id.
# NOTIFICATION_CHAT_ID=replace-with-chat-id
